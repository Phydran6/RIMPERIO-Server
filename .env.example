# ---------------------------------------------------------------------------
# Datei:        .env.example
# Projekt:      RIMPERIO
# Autor:        Phydran6
# Version:      2026.10.31.15.40.00
#
# Beschreibung: Vorlage für die Umgebung. Kopieren nach .env, Werte setzen.
#               Der Installer (install.sh) füllt die Geheimnisse selbst.
#               Im Betrieb wird nichts von Hand editiert — alles im Browser.
# ---------------------------------------------------------------------------

# --- Allgemein -------------------------------------------------------------
# Öffentliche Adresse, unter der der Server erreichbar ist.
# Für TLS per Let's Encrypt eine echte Domain eintragen; sonst die IP.
RIMPERIO_DOMAIN=localhost

# Adresse, auf die Caddy hört.
#   :80                 -> HTTP auf allen Schnittstellen (einfacher Erststart)
#   rmm.example.de      -> Caddy holt automatisch ein Let's-Encrypt-Zertifikat
RIMPERIO_SITE_ADDRESS=:80

# Zeitzone des Servers (für Zeitstempel in der Oberfläche).
TZ=Europe/Berlin

# --- Datenbank (PostgreSQL) ------------------------------------------------
POSTGRES_USER=rimperio
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORT
POSTGRES_DB=rimperio
# An 127.0.0.1 binden heißt: von außen nicht erreichbar. So lassen.
DB_BIND=127.0.0.1

# --- Backend ---------------------------------------------------------------
# Schlüssel zum Signieren der Sitzungs-Token (lang & zufällig!).
RIMPERIO_SECRET_KEY=CHANGE_ME_64_ZEICHEN_ZUFALL
# Erst-Admin, der beim ersten Start angelegt wird.
RIMPERIO_ADMIN_USER=admin
RIMPERIO_ADMIN_PASSWORD=admin
# Gültigkeit einer Sitzung in Minuten.
RIMPERIO_SESSION_MINUTES=720
# Gemeinsames Enrollment-Geheimnis für die Erst-Anmeldung neuer Agents.
# Steht auch im Installer-Aufruf der Agents. Jederzeit im Browser wechselbar.
RIMPERIO_ENROLL_SECRET=CHANGE_ME_ENROLL_GEHEIMNIS

# --- Agent-Standardwerte ---------------------------------------------------
# Wie oft ein Agent sich meldet (Sekunden).
RIMPERIO_CHECKIN_INTERVAL=60
# Ab wann ein Agent als offline gilt (Sekunden ohne Check-in).
RIMPERIO_OFFLINE_AFTER=300
