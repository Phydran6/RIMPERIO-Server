#!/bin/sh
# ---------------------------------------------------------------------------
# Datei:        preuninst
# Projekt:      RIMPERIO — Agent als Synology-Paket
# Autor:        Phydran6
# Version:      2026.11.27.21.00.00
#
# Beschreibung: Vor dem Deinstallieren (nicht bei einem Update): am Server
#               abmelden. Das NAS bleibt in RIMPERIO stehen, falls es dort als
#               NAS verbunden ist – nur der Weg über diesen Agent fällt weg.
# ---------------------------------------------------------------------------

PKG="rimperio-agent"
DEST="${SYNOPKG_PKGDEST:-/var/packages/$PKG/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG/var}"

. "$DEST/bin/common.sh"

if [ "$SYNOPKG_PKG_STATUS" = "UNINSTALL" ] && [ -s "$VAR/etc/agent.json" ]; then
    BIN="$(agent_bin "$DEST")"
    if [ -n "$BIN" ] && [ -x "$BIN" ]; then
        RIMPERIO_HOME="$VAR" RIMPERIO_PACKAGE=synology HOME="$VAR" "$BIN" cleanup > /dev/null 2>&1
    fi
fi
exit 0
