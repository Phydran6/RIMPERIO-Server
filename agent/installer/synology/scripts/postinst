#!/bin/sh
# ---------------------------------------------------------------------------
# Datei:        postinst
# Projekt:      RIMPERIO — Agent als Synology-Paket
# Autor:        Phydran6
# Version:      2026.11.27.21.00.00
#
# Beschreibung: Nach der Installation: Server-Adresse und Zugangsschlüssel aus
#               dem Assistenten hinterlegen. Die eigentliche Anmeldung macht der
#               Agent beim ersten Start selbst; danach ist der Schlüssel aus der
#               Konfiguration gelöscht. Bei einem Update fragt DSM nichts – die
#               Anmeldung bleibt dann, wie sie ist.
# ---------------------------------------------------------------------------

PKG="rimperio-agent"
DEST="${SYNOPKG_PKGDEST:-/var/packages/$PKG/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG/var}"

. "$DEST/bin/common.sh"

# Werte aus dem Installations-Assistenten (WIZARD_UIFILES/install_uifile)
wizard_server="${wizard_server:-}"
wizard_secret="${wizard_secret:-}"
wizard_site="${wizard_site:-}"
wizard_insecure="${wizard_insecure:-false}"

fail() {
    [ -n "$SYNOPKG_TEMP_LOGFILE" ] && echo "$1" > "$SYNOPKG_TEMP_LOGFILE"
    exit 1
}

BIN="$(agent_bin "$DEST")"
[ -n "$BIN" ] || fail "Diese CPU ($(uname -m)) wird nicht unterstützt (nur x86_64, aarch64, armv7)."
chmod 0755 "$DEST"/bin/rimperio-agent-* 2>/dev/null
mkdir -p "$VAR"
chmod 0700 "$VAR" 2>/dev/null

if [ -n "$wizard_server" ] && [ -n "$wizard_secret" ]; then
    INSECURE=""
    [ "$wizard_insecure" = "true" ] && INSECURE="-insecure"
    SITE="${wizard_site:-Standard}"
    HOST="$(hostname 2>/dev/null)"
    # shellcheck disable=SC2086
    RIMPERIO_HOME="$VAR" RIMPERIO_PACKAGE=synology HOME="$VAR" "$BIN" bootstrap \
        -server "$wizard_server" -secret "$wizard_secret" -site "$SITE" \
        -desc "Synology-Paket auf ${HOST:-NAS}" $INSECURE > /dev/null 2>&1 \
        || fail "RIMPERIO Agent: Einstellungen konnten nicht gespeichert werden."
fi

if [ ! -s "$VAR/etc/agent.json" ]; then
    fail "RIMPERIO Agent: Server-Adresse und Zugangsschlüssel fehlen – bitte im Assistenten angeben."
fi
exit 0
