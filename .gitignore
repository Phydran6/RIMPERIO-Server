# Umgebung / Geheimnisse
.env
*.env
!.env.example
*.pem
*.key
*.pfx
*.crt
secrets/

# Python / Backend
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node / Frontend
node_modules/
frontend/dist/
.vite/
npm-debug.log*

# Go / Agent
agent/bin/
agent/dist/
*.exe
*.msi
*.syso

# Datenbank / Laufzeit
pgdata/
data/
*.sqlite
*.db

# Caddy
caddy/data/
caddy/config/

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
