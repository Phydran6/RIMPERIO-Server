# Umgebung / Geheimnisse
.env
.env.*
!.env.example
!server/.env.example
docker-compose.override.yml
*.pem
*.key
*.pfx
*.crt
secrets/

# Python / Backend
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node / Frontend
node_modules/
dist/
.vite/
npm-debug.log*

# Go / Agent
agent/bin/
*.exe
*.msi
*.syso

# Datenbank / Laufzeit
pgdata/
*.dump
backup.sql
*.sqlite

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.log
