# ==============================================================================
# Name:        Phydran6
# Kontakt:     Phydran6
# Version:     2026.07.31.23.00.00
# Beschreibung: RIMPERIO - Caddy Reverse Proxy (Startkonfiguration)
#
# Das ist nur der Zustand beim ersten Start: reines HTTP auf Port 80.
# HTTPS/FQDN wird im Web-UI unter "Einstellungen -> Netzwerk -> Reverse Proxy"
# eingerichtet; die dort erzeugte Konfiguration wird gespeichert und beim Start
# erneut geladen (siehe backend/app/routes/caddy.py).
#
# Port 80 bleibt in JEDER erzeugten Konfiguration erreichbar - es gibt bewusst
# keinen Zwangs-Redirect auf HTTPS, damit man sich nicht aussperren kann.
# ==============================================================================

{
    # Admin-API nur ueber einen Unix-Socket im Volume caddy_admin, das allein
    # Caddy und das Backend eingehaengt haben. Frueher: 0.0.0.0:2019 - offen
    # fuer jeden Container im Docker-Netz, auch fuer n8n & Co.
    admin unix//caddy-admin/admin.sock
}

(rimperio_routes) {
    # Schutz-Kopfzeilen fuer die Oberflaeche (die API setzt ihre eigenen).
    # -Server: nicht verraten, welcher Proxy in welcher Fassung hier steht.
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    handle /api/* {
        reverse_proxy backend:8000 {
            # Erkennung eines externen HTTPS-Proxys + echte Client-IP.
            # Caddy ueberschreibt diese Kopfzeilen, ein Client kann sie nicht faelschen.
            header_up X-Rimperio-Edge-Scheme {http.request.scheme}
            header_up X-Rimperio-Outer-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Rimperio-Peer {http.request.remote.host}
            header_up X-Rimperio-Client-IP {client_ip}
        }
    }
    handle {
        reverse_proxy frontend:80
    }
}

:80 {
    import rimperio_routes
}
